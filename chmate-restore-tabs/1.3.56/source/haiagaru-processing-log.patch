+    private const val LOG_FOLDER = "Haiagaru-processing-logs"
+    private const val MAX_LOG_BYTES = 256L * 1024
+    private val logName = Regex("chmate-processing-[a-zA-Z0-9_-]+\\.log")
+
+    private fun logNode(node: Node) = node.isFile && node.size in 1..MAX_LOG_BYTES
+        && logName.matches(node.name)
+
+    @JvmStatic
+    fun uploadProcessingLog(context: Context, snapshot: File): Unit = runBlocking {
+        requireSupportedAndroid()
+        val length = snapshot.length()
+        if (!snapshot.isFile || length !in 1..MAX_LOG_BYTES) throw IOException("Invalid log size")
+        withSession(context) { mega ->
+            val folder = folder(mega, create = true, name = LOG_FOLDER) ?: throw IOException("Log folder unavailable")
+            val name = "chmate-processing-${System.currentTimeMillis()}-${UUID.randomUUID()}.log"
+            val uploaded = FileInputStream(snapshot).asSource().buffered().use { source ->
+                CancellationToken().use { token -> mega.uploadFile(folder, name, length, source, token) }
+            }
+            if (uploaded.size != length) throw IOException("Log upload size mismatch")
+        }
+    }
+
+    @JvmStatic
+    fun listProcessingLogs(context: Context): Array<MegaFile> = runBlocking {
+        requireSupportedAndroid()
+        withSession(context) { mega ->
+            val folder = folder(mega, create = false, name = LOG_FOLDER) ?: return@withSession emptyArray()
+            mega.getChildren(folder).filter(::logNode).sortedByDescending { it.timestamp.toEpochMilliseconds() }
+                .take(100).map(::describe).toTypedArray()
+        }
+    }
+
+    @JvmStatic
+    fun downloadProcessingLog(context: Context, selected: MegaFile): File = runBlocking {
+        requireSupportedAndroid()
+        withSession(context) { mega ->
+            val folder = folder(mega, create = false, name = LOG_FOLDER) ?: throw IOException("Log folder unavailable")
+            val node = mega.getChildren(folder).firstOrNull {
+                it.hash == selected.hash && it.name == selected.name && it.size == selected.size && logNode(it)
+            } ?: throw IOException("Log unavailable")
+            val output = HaiagaruBackupArchive.temporary(context)
+            try {
+                downloadTo(mega, node, output)
+                output
+            } catch (error: Throwable) {
+                output.delete()
+                throw error
+            }
+        }
+    }
+
     private fun eligible(node: Node) = node.isFile && node.name.startsWith(PREFIX)
         && (node.name.endsWith(".json") || node.name.endsWith(".zip")) && node.size > 0
 
