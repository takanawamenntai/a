@@ -0,0 +1,169 @@
+package app.morphe.extension.chmate;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/** Structured diagnostics with a bounded local journal and opt-in MEGA export. */
+final class ProcessingLog {
+    enum Event { STARTUP, SYNC_START, SYNC_FINISH, BACKUP_UPLOAD, BACKUP_UPLOAD_FINISH,
+        BACKUP_DOWNLOAD, BACKUP_DOWNLOAD_FINISH, RESTORE_PREVIEW, RESTORE_START, RESTORE_FINISH, ZIP_INVALID, OPERATION_FAILED }
+
+    private static final int LIMIT = 256 * 1024;
+    private static final String PREFS = "haiagaru.processing-log";
+    private static final String AUTOMATIC = "automatic";
+    private static final ScheduledExecutorService IO = Executors.newSingleThreadScheduledExecutor();
+    private static final java.util.concurrent.atomic.AtomicBoolean started =
+            new java.util.concurrent.atomic.AtomicBoolean();
+
+    private ProcessingLog() {}
+
+    static void initialize(Context context) {
+        if (!started.compareAndSet(false, true)) return;
+        Context app = context.getApplicationContext();
+        record(app, Event.STARTUP, null);
+        IO.scheduleWithFixedDelay(() -> upload(app), 1, 15, TimeUnit.MINUTES);
+    }
+
+    static void record(Context context, Event event, Throwable failure) {
+        Context app = context.getApplicationContext();
+        long timestamp = System.currentTimeMillis();
+        // Never store exception messages, stack traces, URLs, file paths or credentials.
+        String type = failure == null ? "" : " " + failure.getClass().getSimpleName();
+        IO.execute(() -> {
+            try {
+                File file = journal(app);
+                android.util.AtomicFile atomic = new android.util.AtomicFile(file);
+                byte[] line = (timestamp + " " + event + type + "\n").getBytes(StandardCharsets.UTF_8);
+                if (file.length() + line.length > LIMIT) {
+                    byte[] previous = file.length() <= LIMIT ? read(file) : new byte[0];
+                    int start = Math.max(0, previous.length - LIMIT / 2);
+                    if (start > 0) {
+                        while (start < previous.length && previous[start++] != '\n') { }
+                    }
+                    FileOutputStream output = atomic.startWrite();
+                    try {
+                        output.write(previous, start, previous.length - start);
+                        output.write(line);
+                        atomic.finishWrite(output);
+                    } catch (Exception error) {
+                        atomic.failWrite(output);
+                        throw error;
+                    }
+                } else {
+                    try (FileOutputStream output = new FileOutputStream(file, true)) {
+                        output.write(line);
+                    }
+                }
+            } catch (Exception error) {
+                android.util.Log.w("Haiagaru", "Unable to write processing log");
+            }
+        });
+    }
+
+    private static File journal(Context context) {
+        return new File(context.getFilesDir(), "chmate-processing.log");
+    }
+
+    private static byte[] read(File file) throws java.io.IOException {
+        try (java.io.InputStream in = new java.io.FileInputStream(file);
+             java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream()) {
+            byte[] buffer = new byte[8192];
+            int count;
+            while ((count = in.read(buffer)) != -1) {
+                if (out.size() + count > LIMIT) throw new java.io.IOException("Log exceeds size limit");
+                out.write(buffer, 0, count);
+            }
+            return out.toByteArray();
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, 0);
+    }
+
+    private static void upload(Context context) {
+        SharedPreferences settings = prefs(context);
+        if (!settings.getBoolean(AUTOMATIC, false) || !HaiagaruMegaSession.hasSession(context)) return;
+        File file = journal(context);
+        if (!file.isFile() || file.length() == 0) return;
+        try {
+            String digest = android.util.Base64.encodeToString(
+                    java.security.MessageDigest.getInstance("SHA-256").digest(read(file)), android.util.Base64.NO_WRAP);
+            if (digest.equals(settings.getString("uploaded", ""))) return;
+            HaiagaruMegaClient.uploadProcessingLog(context, file);
+            settings.edit().putString("uploaded", digest).apply();
+        } catch (Exception error) {
+            android.util.Log.w("Haiagaru", "MEGA processing log upload failed: " + error.getClass().getSimpleName());
+        }
+    }
+
+    static void addControls(LinearLayout layout, Activity activity) {
+        CheckBox automatic = new CheckBox(activity);
+        automatic.setText("処理ログをMEGAへ自動保存");
+        automatic.setChecked(prefs(activity).getBoolean(AUTOMATIC, false));
+        automatic.setOnCheckedChangeListener((button, checked) -> {
+            prefs(activity).edit().putBoolean(AUTOMATIC, checked).apply();
+            if (checked) IO.execute(() -> upload(activity.getApplicationContext()));
+        });
+        layout.addView(automatic);
+        Button download = new Button(activity);
+        download.setText("MEGAの処理ログをダウンロード");
+        download.setOnClickListener(view -> {
+            download.setEnabled(false);
+            IO.execute(() -> list(activity, download));
+        });
+        layout.addView(download);
+    }
+
+    private static void list(Activity activity, Button button) {
+        try {
+            HaiagaruMegaClient.MegaFile[] files = HaiagaruMegaClient.listProcessingLogs(activity);
+            String[] labels = new String[files.length];
+            for (int i = 0; i < labels.length; i++) labels[i] = files[i].name;
+            activity.runOnUiThread(() -> {
+                if (activity.isFinishing() || activity.isDestroyed()) return;
+                button.setEnabled(true);
+                if (labels.length == 0) {
+                    Toast.makeText(activity, "MEGAに処理ログがありません", Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                new HaiagaruDialog.Builder(activity).setTitle("ダウンロードする処理ログ")
+                        .setItems(labels, (dialog, index) -> IO.execute(() -> download(activity, files[index])))
+                        .setNegativeButton("キャンセル", null).show();
+            });
+        } catch (Exception error) {
+            activity.runOnUiThread(() -> {
+                button.setEnabled(true);
+                Toast.makeText(activity, "MEGAのログ一覧を取得できませんでした", Toast.LENGTH_LONG).show();
+            });
+        }
+    }
+
+    private static void download(Activity activity, HaiagaruMegaClient.MegaFile selected) {
+        File temporary = null;
+        String result;
+        try {
+            temporary = HaiagaruMegaClient.downloadProcessingLog(activity, selected);
+            Haiagaru.writeDownloadLog(activity, selected.name, new String(read(temporary), StandardCharsets.UTF_8));
+            result = "処理ログをダウンロードに保存しました";
+        } catch (Exception error) {
+            result = "処理ログをダウンロードできませんでした";
+        } finally {
+            if (temporary != null) temporary.delete();
+        }
+        final String message = result;
+        activity.runOnUiThread(() -> Toast.makeText(activity, message, Toast.LENGTH_LONG).show());
+    }
+}
